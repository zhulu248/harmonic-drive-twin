\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Pendulum verification run — TPI 275 size 17, ratio 100:1, \(T = \SI {20}{\degreeCelsius }\). \textbf  {Top:} joint angle settling from \SI {45}{\degree } to \SI {0}{\degree }. \textbf  {Second:} output torque (load) vs.\ motor input torque; motor torque is \(\approx 100\times \) smaller due to the reduction. \textbf  {Third:} transmission efficiency; drops to \SI {0}{\percent } at zero velocity (undefined) and reaches \SI {80}{\percent }--\SI {85}{\percent } during motion. \textbf  {Bottom:} loss channel breakdown; churn+seal (load-free) dominates at low speed, tooth-flank friction at high load.}}{7}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pendulum}{{1}{7}{Pendulum verification run — TPI 275 size 17, ratio 100:1, \(T = \SI {20}{\degreeCelsius }\). \textbf {Top:} joint angle settling from \SI {45}{\degree } to \SI {0}{\degree }. \textbf {Second:} output torque (load) vs.\ motor input torque; motor torque is \(\approx 100\times \) smaller due to the reduction. \textbf {Third:} transmission efficiency; drops to \SI {0}{\percent } at zero velocity (undefined) and reaches \SI {80}{\percent }--\SI {85}{\percent } during motion. \textbf {Bottom:} loss channel breakdown; churn+seal (load-free) dominates at low speed, tooth-flank friction at high load}{figure.caption.1}{}}
